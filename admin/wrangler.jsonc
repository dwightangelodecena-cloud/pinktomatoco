// Cloudflare Worker for the Pink Tomato admin, opened inside the BigCommerce control panel under Apps.
{
  "name": "pinktomato-admin",
  "main": "worker/index.js",
  // From 2026-08-04 Node.js compatibility is on by default.
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // These paths are handled by the Worker, not served as files.
    "run_worker_first": ["/api/*", "/auth", "/load", "/uninstall", "/dev-login", "/media/*"]
  },
  // Holds the store's access token from the app install. Create it with
  // `npx wrangler kv namespace create STORE` and put its id here before the first deploy.
  "kv_namespaces": [
    { "binding": "STORE", "id": "5c306f9fbf7a4c408baabc6a83b81d5b" }
  ],
  "vars": {
    "STORE_HASH": "v7sdscf7vw",
    "CHANNEL_ID": "1"
  }
  // Secrets (never in this file): BC_CLIENT_ID, BC_CLIENT_SECRET, SESSION_SECRET.
  // Set with `npx wrangler secret put NAME`. For local work they go in .dev.vars, which git ignores.
}
